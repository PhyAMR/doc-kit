% phunotes.sty: the look of notes, books and reports. Loads phumacros.
%
%   Quarto:  format: phu-pdf          (the phu extension loads it)
%   LaTeX:   \usepackage{phunotes}    ([cm] keeps Computer Modern)
%
% The look (doc-kit style specimens, 2026-10-08): EB Garamond with Plex
% Mono for code, Atlas rust accent, white page.
%   headings   small-caps "chapter 03" eyebrow over a rule; accent numbers
%   results    (theorem, lemma...) and definitions: drafting corner marks
%   exercises, examples, solutions: a sheet with a title-block header row
%   remarks    small and faint; callouts: label hung left of a thin rule
%   code       no fill, rule above, language tag; output tagged "out"
% Quarto defines the theorem environments itself (::: {#thm-...}); in
% plain LaTeX this package defines any that are missing.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{phunotes}[2026/10/08 notes look]

\newif\ifphu@fonts \phu@fontstrue
\DeclareOption{cm}{\phu@fontsfalse}
\ProcessOptions\relax

\RequirePackage{phumacros}
\RequirePackage{amsthm}
\RequirePackage{etoolbox}
\RequirePackage{enumitem}
% fancyvrb, not fvextra: fvextra loads lineno, and with lineno a box taller
% than the page (a big figure) makes LaTeX ship empty pages forever.
\RequirePackage{fancyvrb}
\RequirePackage{tikz}
\RequirePackage[framemethod=TikZ]{mdframed}
\RequirePackage{caption}
\usetikzlibrary{calc,arrows.meta,positioning,shapes.geometric,fit,
                decorations.pathreplacing,matrix,patterns}

% --- fonts ------------------------------------------------------------
\RequirePackage{iftex}
\ifphu@fonts
  \ifPDFTeX
    \RequirePackage[lining,semibold]{ebgaramond}
    \let\Bbbk\relax % amssymb (loaded first by Quarto) vs newtxmath
    \RequirePackage[cmintegrals,cmbraces]{newtxmath}
    % ebgaramond-maths turns these into errors (no glyph in EB Garamond);
    % keep the definitions they had (newtxmath's, or the macros' \vec)
    \def\phu@keep{leftharpoonup,leftharpoondown,rightharpoonup,rightharpoondown,%
      triangleright,triangleleft,star,partial,flat,natural,sharp,smile,frown,vec,t}
    \@for\phu@s:=\phu@keep\do{\expandafter\let\csname phu@k@\phu@s\expandafter\endcsname
      \csname\phu@s\endcsname}
    \RequirePackage{ebgaramond-maths}
    \@for\phu@s:=\phu@keep\do{\expandafter\let\csname\phu@s\expandafter\endcsname
      \csname phu@k@\phu@s\endcsname}
    \RequirePackage[scale=0.85]{plex-mono}
  \else % LuaLaTeX (phu-pdf, Quarto's pdf) / XeLaTeX: fontspec
    \RequirePackage{fontspec}
    \ifdefined\directlua
      % Characters the look's fonts lack (Greek in Plex Mono, CJK, Hebrew,
      % emoji, rare symbols) come from fallback fonts, the installed ones of
      % these, so no character in printed output stops the PDF.
      \directlua{
        local function installed(faces)
          local out = {}
          for _, face in ipairs(faces) do
            local file = face:match("^[^(]+")
            if kpse.find_file(file, "opentype fonts") or kpse.find_file(file, "truetype fonts") then
              table.insert(out, "file:" .. face .. ":mode=harf;")
            end
          end
          return out
        end
        luaotfload.add_fallback("phuserif", installed({"FreeSerif.otf", "NotoSansCJK-Regular.ttc(0)",
          "NotoSansHebrew-Regular.ttf", "NotoColorEmoji.ttf"}))
        luaotfload.add_fallback("phumono", installed({"NotoSansMono-Regular.ttf", "DejaVuSansMono.ttf",
          "NotoSansCJK-Regular.ttc(0)", "NotoSansHebrew-Regular.ttf", "NotoColorEmoji.ttf"}))
      }
      \defaultfontfeatures[EBGaramond]{RawFeature={fallback=phuserif}}
      \defaultfontfeatures[IBMPlexMono]{RawFeature={fallback=phumono}}
    \fi
    \setmainfont{EBGaramond}[Extension=.otf, UprightFont=*-Regular,
      ItalicFont=*-Italic, BoldFont=*-SemiBold, BoldItalicFont=*-SemiBoldItalic,
      Numbers=Lining]
    \setmonofont{IBMPlexMono}[Extension=.otf, UprightFont=*-Regular,
      ItalicFont=*-Italic, BoldFont=*-SemiBold, Scale=0.85]
    % a bold version too, or \boldsymbol (\vb, \vec) finds no glyphs
    \@ifpackageloaded{unicode-math}{%
      \setmathfont{Garamond-Math.otf}[StylisticSet={7,9}]%
      \setmathfont{Garamond-Math.otf}[StylisticSet={7,9}, version=bold, FakeBold=2]}{}
  \fi
\fi
\RequirePackage{microtype} % after the fonts; \textls for the labels

% --- colours ----------------------------------------------------------
\definecolor{accent}  {HTML}{b4442b} % atlas rust
\definecolor{ink}     {HTML}{1f1d1a}
\definecolor{inkSoft} {HTML}{4b463e}
\definecolor{inkFaint}{HTML}{6f6a61}
\definecolor{rule}    {HTML}{c9c0ad}
\definecolor{codeBg}  {HTML}{f4f2ee}
\color{ink}

% Small-caps label: "Theorem 3.2" -> letter-spaced small caps.
\DeclareRobustCommand*{\phulabel}[1]{{\scshape\textls[70]{\MakeLowercase{#1}}}}

\makeatletter
% --- headings (KOMA classes only: scrbook, scrreprt, scrartcl) --------
\AtBeginDocument{\let\phu@doctitle\@title}
\ifdefined\addtokomafont
  \setkomafont{disposition}{\normalfont}
  \setkomafont{section}      {\normalfont\Large\bfseries}
  \setkomafont{subsection}   {\normalfont\large\bfseries}
  \setkomafont{subsubsection}{\normalfont\normalsize\bfseries}
  \setkomafont{paragraph}    {\normalfont\normalsize\itshape}
  \newcommand*\phu@secnum[1]{{\mdseries\small\color{accent}#1}\hspace{.75em}}
  \renewcommand*\sectionformat      {\phu@secnum{\thesection}}
  \renewcommand*\subsectionformat   {\phu@secnum{\thesubsection}}
  \renewcommand*\subsubsectionformat{\phu@secnum{\thesubsubsection}}
  \ifdefined\chapterformat
    \setkomafont{chapter}{\normalfont\fontsize{26}{30}\selectfont}
    \RedeclareSectionCommand[beforeskip=1.5\baselineskip,
      afterskip=2.2\baselineskip]{chapter}
    % numbered: "chapter 03 ........ book title" over a rule, then the title
    \renewcommand*\chapterformat{%
      \phulabel{\chapapp}~{\color{accent}\ifnum\value{chapter}<10 0\fi\thechapter}}
    \renewcommand*\chapterlinesformat[3]{%
      \Ifstr{#1}{chapter}{%
        \Ifstr{#2}{}{}{%
          {\normalfont\normalsize\color{inkFaint}%
           \hbox to\linewidth{#2\hfill\phulabel{\phu@doctitle}}%
           \vskip3pt{\color{ink}\hrule height .5pt}\vskip .6\baselineskip}}%
        \raggedright #3}%
      {\@hangfrom{#2}{#3}}}
  \fi
\fi

% --- a report as a book chapter ---------------------------------------
% phu.lua puts this under the chapter title of a report in a book:
% \begin{phureport}{subtitle}{authors · date} abstract \end{phureport}
\newenvironment{phureport}[2]{%
  \par\vspace*{-1.2\baselineskip}%
  \if\relax\detokenize{#1}\relax\else
    {\raggedright\large\itshape\color{inkSoft}#1\par}\vspace{.3\baselineskip}\fi
  \if\relax\detokenize{#2}\relax\else
    {\raggedright\color{inkFaint}\phulabel{#2}\par}\fi
  \vspace{.7\baselineskip}%
  \begingroup\small\leftskip=2em\rightskip=2em\relax
}{\par\endgroup\vspace{.2\baselineskip}}
\newcommand*\phureportabstract{%
  {\color{inkFaint}\phulabel{Abstract}}\par\nobreak\vspace{.2\baselineskip}}

% --- theorem-like environments ----------------------------------------
% Quarto creates them with \theoremstyle{plain|definition|remark}; a hook
% swaps those styles for ours inside each environment, and an mdframed
% around it draws the frame.
\newcommand*\phu@headcolor{accent}
\newcommand*\phu@framecolor{accent}
\newcommand*\phu@lastexr{}
\newcommand*\phu@sheetright{}

% results and definitions: label line, upright body
\newtheoremstyle{phuCorner}{0pt}{0pt}{\upshape}{0pt}{}{}{\newline}
  {\textcolor{\phu@headcolor}{\phulabel{\thmname{#1}\thmnumber{~#2}}}%
   \thmnote{\enspace\textcolor{inkFaint}{\textperiodcentered}\enspace
     \textcolor{inkSoft}{\itshape #3}}}
% exercises, examples, solutions: header row with a hairline under it
\newtheoremstyle{phuSheet}{0pt}{0pt}{\upshape}{0pt}{}{}{\newline}
  {\vbox{\hbox to\linewidth{%
      \phulabel{\thmname{#1}}\thmnumber{~\textcolor{accent}{\phulabel{#2}}}%
      \thmnote{\enspace\textcolor{inkFaint}{\textperiodcentered}\enspace
        \textcolor{inkSoft}{\itshape #3}}%
      \hfill\phu@sheetright}%
    \nointerlineskip\kern3pt\hbox{\color{rule}\vrule width\linewidth height .4pt}}}
% remarks: run-in, small, faint
\newtheoremstyle{phuQuiet}{4pt}{4pt}{\small\color{inkSoft}}{0pt}{\itshape}{.}{.5em}{}

\newcommand*\phu@style[1]{%
  \expandafter\let\csname th@plain\expandafter\endcsname\csname th@#1\endcsname
  \expandafter\let\csname th@definition\expandafter\endcsname\csname th@#1\endcsname
  \expandafter\let\csname th@remark\expandafter\endcsname\csname th@#1\endcsname}

% corner marks: top left and bottom right of the box
\newcommand*\phu@corner[3]{%
  \draw[\phu@framecolor, line width=.5pt]
    ($#1+(#2*9pt,0)$) -- #1 -- ($#1+(0,#3*9pt)$);}
\mdfdefinestyle{phuCorners}{
  hidealllines=true,
  innertopmargin=5pt, innerbottommargin=2pt,
  innerleftmargin=10pt, innerrightmargin=10pt,
  skipabove=10pt, skipbelow=10pt,
  singleextra={\phu@corner{(O|-P)}{1}{-1}\phu@corner{(P|-O)}{-1}{1}},
  firstextra={\phu@corner{(O|-P)}{1}{-1}},
  secondextra={\phu@corner{(P|-O)}{-1}{1}},
}
\mdfdefinestyle{phuSheet}{
  linecolor=ink, linewidth=.6pt,
  leftline=false, rightline=false,
  innertopmargin=4pt, innerbottommargin=2pt,
  innerleftmargin=0pt, innerrightmargin=0pt,
  skipabove=10pt, skipbelow=10pt,
}

\newcommand*\phuCornerEnv[2]{% #1 environment, #2 colour (accent | ink)
  \BeforeBeginEnvironment{#1}{\def\phu@framecolor{#2}\begin{mdframed}[style=phuCorners]}%
  \AtBeginEnvironment{#1}{\phu@style{phuCorner}\def\phu@headcolor{#2}}%
  \AfterEndEnvironment{#1}{\end{mdframed}}}
\newcommand*\phuSheetEnv[2]{% #1 environment, #2 right header cell
  \BeforeBeginEnvironment{#1}{\begin{mdframed}[style=phuSheet]}%
  \AtBeginEnvironment{#1}{\phu@style{phuSheet}\def\phu@sheetright{#2}}%
  \AfterEndEnvironment{#1}{\end{mdframed}}}
\newcommand*\phuQuietEnv[1]{\AtBeginEnvironment{#1}{\phu@style{phuQuiet}}}

\newcommand*\phu@where{% "§ 3.2" once inside a section
  \ifnum\value{section}>0 \textcolor{inkFaint}{\vrule\enspace\S\,\thesection}\fi}
\newcommand*\phu@forexr{% "ex. 3.4" after an exercise
  \ifx\phu@lastexr\@empty\else
    \textcolor{inkFaint}{\vrule\enspace\phulabel{Ex.}~\phu@lastexr}\fi}

\phuCornerEnv{theorem}{accent}
\phuCornerEnv{proposition}{accent}
\phuCornerEnv{lemma}{accent}
\phuCornerEnv{corollary}{accent}
\phuCornerEnv{conjecture}{accent}
\phuCornerEnv{definition}{ink}
\phuSheetEnv{exercise}{\phu@where}
\phuSheetEnv{example}{\phu@where}
\phuSheetEnv{solution}{\phu@forexr}
\phuSheetEnv{refsolution}{\phu@forexr}
\phuQuietEnv{remark}
\phuQuietEnv{refremark}
\AfterEndEnvironment{exercise}{\xdef\phu@lastexr{\theexercise}}
\renewcommand{\qedsymbol}{\textcolor{inkFaint}{$\square$}}

% Plain LaTeX: define what Quarto would have defined.
\AtEndPreamble{%
  \@ifundefined{c@chapter}{\def\phu@within{section}}{\def\phu@within{chapter}}%
  \theoremstyle{plain}%
  \@ifundefined{theorem}{\newtheorem{theorem}{Theorem}[\phu@within]}{}%
  \@ifundefined{proposition}{\newtheorem{proposition}[theorem]{Proposition}}{}%
  \@ifundefined{lemma}{\newtheorem{lemma}[theorem]{Lemma}}{}%
  \@ifundefined{corollary}{\newtheorem{corollary}[theorem]{Corollary}}{}%
  \@ifundefined{conjecture}{\newtheorem{conjecture}[theorem]{Conjecture}}{}%
  \theoremstyle{definition}%
  \@ifundefined{definition}{\newtheorem{definition}{Definition}[\phu@within]}{}%
  \@ifundefined{example}{\newtheorem{example}{Example}[\phu@within]}{}%
  \@ifundefined{exercise}{\newtheorem{exercise}{Exercise}[\phu@within]}{}%
  \theoremstyle{remark}%
  \@ifundefined{remark}{\newtheorem*{remark}{Remark}}{}%
  \@ifundefined{solution}{\newtheorem*{solution}{Solution}}{}%
}

% --- callouts (phu.lua turns Quarto callouts into phucallout) ---------
% \begin{phucallout}{note}{title or empty}: the label hangs left of a
% thin rule; warning, important and caution take the accent.
\newcommand*\phu@calloutline{rule}
\newcommand*\phu@calloutlabel{inkFaint}
\newcommand*\phu@calloutkind{}
\newcommand*\phu@calloutlabeltag{%
  \node[anchor=north east, inner sep=0pt, xshift=-10pt, yshift=-2.5pt,
        text=\phu@calloutlabel, font=\footnotesize] at (O|-P)
    {\phulabel{\phu@calloutkind}};}
\mdfdefinestyle{phuCallout}{
  topline=false, bottomline=false, rightline=false,
  linewidth=.6pt, leftmargin=5.2em,
  innertopmargin=1pt, innerbottommargin=2pt,
  innerleftmargin=10pt, innerrightmargin=0pt,
  skipabove=8pt, skipbelow=8pt,
  singleextra={\phu@calloutlabeltag}, firstextra={\phu@calloutlabeltag},
}
\newcommand*\phu@alarm{warning,important,caution}
\newenvironment{phucallout}[2]{%
  \def\phu@calloutline{rule}\def\phu@calloutlabel{inkFaint}\def\phu@calloutkind{#1}%
  \@for\phu@k:=\phu@alarm\do{\expandafter\ifstrequal\expandafter{\phu@k}{#1}%
    {\def\phu@calloutline{accent}\def\phu@calloutlabel{accent}}{}}%
  \begin{mdframed}[style=phuCallout, linecolor=\phu@calloutline]%
  \ifstrempty{#2}{}{\textit{#2}\par}}
  {\end{mdframed}}

% --- code and code output ---------------------------------------------
% phu.lua puts \phucodelang{python} before each code cell; phu-output.lua
% puts console output (stdout, messages, errors) in phuout[out|msg|error].
\newcommand*\phu@lang{}
\newcommand*\phucodelang[1]{\gdef\phu@lang{#1}}
\newcommand*\phu@langtag{%
  \ifx\phu@lang\@empty\else
    \node[anchor=east, fill=white, inner xsep=4pt, inner ysep=1pt,
          text=inkFaint, font=\footnotesize] at (P) {\phulabel{\phu@lang}};\fi}
\mdfdefinestyle{phuCode}{
  hidealllines=true,
  innertopmargin=7pt, innerbottommargin=5pt,
  innerleftmargin=0pt, innerrightmargin=0pt,
  skipabove=8pt, skipbelow=4pt,
  singleextra={\draw[ink, line width=.5pt] (O|-P) -- (P);
               \draw[rule, line width=.4pt] (O) -- (P|-O); \phu@langtag},
  firstextra={\draw[ink, line width=.5pt] (O|-P) -- (P); \phu@langtag},
  secondextra={\draw[rule, line width=.4pt] (O) -- (P|-O);},
}
\AtEndPreamble{%
  \ifdefined\Shaded
    \renewenvironment{Shaded}
      {\begin{mdframed}[style=phuCode]}
      {\end{mdframed}\gdef\phu@lang{}}%
  \fi}
\newenvironment{phuout}[1][out]
  {\small % console lines of 80 characters fit the text width
   \begin{list}{}{\leftmargin=2.8em \labelwidth=2.2em \labelsep=.6em
                  \topsep=2pt \partopsep=0pt \itemsep=0pt}%
   \ifstrequal{#1}{msg}{\def\phu@outcolor{inkFaint}}{\def\phu@outcolor{accent}}%
   \item[\textcolor{\phu@outcolor}{\footnotesize\phulabel{#1}}]}
  {\end{list}}
\fvset{fontsize=\small}
\newenvironment{codeoutput}{\begin{phuout}\small\ttfamily}{\end{phuout}}

% --- matrices and tables from code (phu.py / phu.R) -----------------
% phu-output.lua wraps a matrix in phuarray and its "float64 · 3 × 4" line
% in \phushape; \phuneg (negatives) is in phu-macros.tex, for MathJax too.
% the gap marks in truncated tables, in both engines
\RequirePackage{newunicodechar}
\newunicodechar{⋮}{\ensuremath{\vdots}}
\newunicodechar{⋯}{\ensuremath{\cdots}}
\newunicodechar{⋱}{\ensuremath{\ddots}}
\newunicodechar{−}{\ensuremath{-}}
\newenvironment{phuarray}{\par\begin{center}}{\end{center}}
\newcommand*\phushape[1]{\par\vspace{-3pt}{\footnotesize\color{inkFaint}\phulabel{#1}}}

% --- two-column documents ---------------------------------------------
% longtable (every pandoc table) refuses two-column mode. There, a
% longtable becomes a column-wide table float: caption kept, the repeated
% page head dropped, shrunk to the column when too wide.
\newsavebox\phu@tbox
\long\def\phu@ltcap\caption#1\tabularnewline{\gdef\phu@cap{\caption#1}\phu@ltstart}
\newcommand*\phu@ltspec{}
\newcommand*\phu@begtab[1]{\begin{tabular}{#1}}
\newcommand*\phu@ltstart{\begin{lrbox}{\phu@tbox}\expandafter\phu@begtab\expandafter{\phu@ltspec}}
\AtBeginDocument{%
  \if@twocolumn
    \renewenvironment{longtable}[2][]{%
      \def\phu@ltspec{#2}\gdef\phu@cap{}%
      \long\def\endfirsthead##1\endlastfoot{}%
      \long\def\endhead##1\endlastfoot{}%
      \small\@ifnextchar\caption{\phu@ltcap}{\phu@ltstart}}
      {\bottomrule\end{tabular}\end{lrbox}%
       \def\phu@fit{\ifdim\wd\phu@tbox>\linewidth
         \resizebox{\linewidth}{!}{\usebox\phu@tbox}\else\usebox\phu@tbox\fi}%
       \ifx\phu@cap\@empty % code output and plain tables stay in place
         \par\begin{center}\phu@fit\end{center}%
       \else
         \begin{table}[tbp]\centering\phu@cap\par\phu@fit\end{table}%
       \fi}%
  \fi}

% --- captions ---------------------------------------------------------
\DeclareCaptionLabelFormat{phu}{\textcolor{accent}{\phulabel{#1~#2}}}
\DeclareCaptionFormat{phuFig}{{\color{ink}\hrule height .5pt}\vskip4pt#1#2#3}
\captionsetup{labelformat=phu, labelsep=quad, font=small,
  justification=raggedright, singlelinecheck=false}
\captionsetup[figure]{format=phuFig, name=Fig.}
\makeatother

% --- spacing ----------------------------------------------------------
\setlist{itemsep=2pt, topsep=4pt, parsep=0pt}
\setlength{\parskip}{0.4em plus 0.1em minus 0.05em}
\setlength{\parindent}{0pt}
\setlength{\arraycolsep}{4pt}
\renewcommand{\arraystretch}{1.1}

\endinput
