# phu.mplstyle: matplotlib in the phunotes look (doc-kit), the "plate":
# drafting grid, framed axes, ticks inside, graphite lines, one rust accent.
# In Quarto kernels phu.py sets MATPLOTLIBRC to this file; elsewhere
#   plt.style.use("~/code/doc-kit/python/phu.mplstyle")

font.family:          serif
font.serif:           EB Garamond, Garamond, DejaVu Serif
font.monospace:       IBM Plex Mono, DejaVu Sans Mono
font.size:            10
mathtext.fontset:     custom
mathtext.rm:          EB Garamond
mathtext.it:          EB Garamond:italic
mathtext.bf:          EB Garamond:bold
mathtext.cal:         EB Garamond:italic
mathtext.sf:          EB Garamond
mathtext.tt:          IBM Plex Mono
mathtext.fallback:    stix

text.color:           1f1d1a
axes.edgecolor:       1f1d1a
axes.linewidth:       0.8
axes.labelcolor:      1f1d1a
axes.labelsize:       10
axes.titlesize:       10
axes.titlelocation:   left
axes.titleweight:     normal
axes.grid:            True
axes.grid.which:      both
axes.axisbelow:       True
axes.prop_cycle:      cycler(color=["1f1d1a", "b4442b", "8a8374", "4b463e", "c9c0ad"], linestyle=["-", "-", "--", "-.", ":"])

grid.color:           ece6da
grid.linewidth:       0.6

xtick.direction:      in
ytick.direction:      in
xtick.top:            True
ytick.right:          True
xtick.minor.visible:  True
ytick.minor.visible:  True
xtick.color:          1f1d1a
ytick.color:          1f1d1a
xtick.labelcolor:     6f6a61
ytick.labelcolor:     6f6a61
xtick.labelsize:      8.5
ytick.labelsize:      8.5
xtick.major.size:     4
ytick.major.size:     4
xtick.minor.size:     2
ytick.minor.size:     2
xtick.major.width:    0.7
ytick.major.width:    0.7
xtick.minor.width:    0.5
ytick.minor.width:    0.5

lines.linewidth:      1.3
lines.markersize:     4
patch.edgecolor:      ffffff
patch.force_edgecolor: True
patch.linewidth:      0.6
hist.bins:            auto
scatter.edgecolors:   face
image.cmap:           Greys
errorbar.capsize:     2

legend.frameon:       False
legend.fontsize:      9
legend.handlelength:  2.2

figure.facecolor:     white
figure.dpi:           150
savefig.facecolor:    white
savefig.bbox:         tight
savefig.pad_inches:   0.05
