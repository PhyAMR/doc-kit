{
  "eq": {
    "prefix": "eq",
    "body": [
      "\\begin{equation}",
      "\t$1",
      "\t\\label{eq:$2}",
      "\\end{equation}$0"
    ],
    "description": "numbered equation"
  },
  "ali": {
    "prefix": "ali",
    "body": [
      "\\begin{align}",
      "\t$1 &= $2 \\label{eq:$3}",
      "\\end{align}$0"
    ],
    "description": "align"
  },
  "sec": {
    "prefix": "sec",
    "body": [
      "\\section{$1}\\label{sec:$2}",
      "$0"
    ],
    "description": "section"
  },
  "ssec": {
    "prefix": "ssec",
    "body": [
      "\\subsection{$1}\\label{sec:$2}",
      "$0"
    ],
    "description": "subsection"
  },
  "fig": {
    "prefix": "fig",
    "body": [
      "\\begin{figure}[htbp]",
      "\t\\centering",
      "\t\\includegraphics[width=${1:0.8}\\linewidth]{$2}",
      "\t\\caption{$3}",
      "\t\\label{fig:$4}",
      "\\end{figure}$0"
    ],
    "description": "figure"
  },
  "tab": {
    "prefix": "tab",
    "body": [
      "\\begin{table}[htbp]",
      "\t\\centering",
      "\t\\caption{$1}",
      "\t\\label{tab:$2}",
      "\t\\begin{tabular}{${3:lc}}",
      "\t\t\\toprule",
      "\t\t$4 \\\\\\\\",
      "\t\t\\midrule",
      "\t\t$5 \\\\\\\\",
      "\t\t\\bottomrule",
      "\t\\end{tabular}",
      "\\end{table}$0"
    ],
    "description": "table (booktabs)"
  },
  "tikz": {
    "prefix": "tikz",
    "body": [
      "\\begin{figure}[htbp]",
      "\t\\centering",
      "\t\\begin{tikzpicture}",
      "\t\t$1",
      "\t\\end{tikzpicture}",
      "\t\\caption{$2}",
      "\t\\label{fig:$3}",
      "\\end{figure}$0"
    ],
    "description": "TikZ figure"
  },
  "proof": {
    "prefix": "proof",
    "body": [
      "\\begin{proof}",
      "\t$1",
      "\\end{proof}$0"
    ],
    "description": "proof"
  },
  "rem": {
    "prefix": "rem",
    "body": [
      "\\begin{remark}",
      "\t$1",
      "\\end{remark}$0"
    ],
    "description": "remark"
  },
  "beg": {
    "prefix": "beg",
    "body": [
      "\\begin{$1}",
      "\t$2",
      "\\end{$1}$0"
    ],
    "description": "any environment"
  },
  "item": {
    "prefix": "item",
    "body": [
      "\\begin{itemize}",
