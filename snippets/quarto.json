  },
  "hdrrep": {
    "prefix": "hdrrep",
    "body": [
      "---",
      "title: \"${1:Title}\"",
      "author: \"Alvaro Mendez\"",
      "date: today",
      "toc: true",
      "number-sections: true",
      "format:",
      "  pdf:",
      "    highlight-style: /home/phuniverse/code/doc-kit/extensions/phu/phu.theme",
      "    documentclass: scrartcl",
      "    include-in-header:",
      "      text: \\\\usepackage{phunotes}",
      "  html:",
      "    theme: [cosmo, /home/phuniverse/code/doc-kit/extensions/phu/phu.scss]",
      "    highlight-style: /home/phuniverse/code/doc-kit/extensions/phu/phu.theme",
      "  epub:",
      "    css: /home/phuniverse/code/doc-kit/extensions/phu/phu-epub.css",
      "    html-math-method: mathml",
      "filters:",
      "  - /home/phuniverse/code/doc-kit/extensions/phu/phu.lua",
      "---",
      "",
      "$0"
    ],
    "description": "header: report (KOMA article, TOC, numbered sections)"
  },
  "hdrslides": {
    "prefix": "hdrslides",
    "description": "header: reveal.js slides",
    "body": [
      "---",
      "title: \"${1:Title}\"",
      "author: \"Alvaro Mendez\"",
      "date: today",
      "format:",
      "  revealjs:",
      "    slide-number: true",
      "    html-math-method: mathjax",
      "filters:",
      "  - /home/phuniverse/code/doc-kit/extensions/phu/phu.lua",
      "---",
      "",
      "## ${2:First slide}",
      "",
      "$0"
    ]
  }
}
