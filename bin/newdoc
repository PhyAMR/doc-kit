#!/usr/bin/env python3
"""newdoc: start a Quarto book/report/paper or a LaTeX document from doc-kit.

Shared files are never copied. In a Quarto project, _extensions is a
symlink to the kit's extensions/ (Quarto doesn't follow links *inside*
_extensions, so the whole folder is linked); LaTeX finds phunotes and
phumacros through $TEXMFHOME (install.sh links them). So fixing the kit fixes
every document. Author details: ~/.config/doc-kit/author.conf.

  newdoc book   ~/Master/4sem/Thesis/notes -t "Thesis notes"
  newdoc report reports/lab1             -t "Lab 1"
  newdoc report reports/lab1 -2          -t "Lab 1"   # two columns
  newdoc report notes/assignments/hw1    -t "Homework 1"
      # inside a book: also listed in the book's chapters, in the part
      # "Assignments" (--part NAME); it still renders alone from its folder
  newdoc paper  ~/Work/CMB/v2   -t "Large-angle statistics"
  newdoc tex    draft                    -t "Draft"
  newdoc link   [DIR]          # point an existing Quarto folder's _extensions at the kit
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import sys
from pathlib import Path

KIT = Path(__file__).resolve().parent.parent   # the doc-kit checkout
AUTHOR_CONF = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "doc-kit" / "author.conf"
PROJECTS = KIT / "projects"
EXTENSIONS = KIT / "extensions"

KINDS = ("book", "report", "paper", "tex")
GITIGNORE = {"book": "quarto", "report": "quarto", "paper": "quarto", "tex": "tex"}


def die(msg: str) -> None:
    print(f"newdoc: {msg}", file=sys.stderr)
    sys.exit(1)


def slugify(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-") or "main"


def author_vars() -> dict[str, str]:
    out = {}
    conf = AUTHOR_CONF
    if conf.exists():
        for line in conf.read_text().splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                key, val = line.split("=", 1)
                out[key.strip()] = val.strip()
    return out


def link_extensions(dest: Path) -> None:
    link = dest / "_extensions"
    if link.is_symlink():
        link.unlink()
    elif link.exists():   # an old per-project copy
        backup = dest / "_extensions.bak"
        if backup.exists():
            die(f"{link} is a real folder and {backup} already exists; move one of them")
        link.rename(backup)
        print(f"  moved the old copy to {backup.name} (delete it once renders work)")
    link.symlink_to(EXTENSIONS)
    print(f"  linked _extensions -> {EXTENSIONS}")


def enclosing_book(dest: Path) -> Path | None:
    """The _quarto.yml of the book project `dest` sits in, if any."""
    for folder in dest.parents:
        yml = folder / "_quarto.yml"
        if yml.is_file():
            return yml if re.search(r"^\s*type:\s*book\b", yml.read_text(), re.M) else None
    return None


def chapter_files(items) -> list[str]:
    out = []
    for item in items or []:
        if isinstance(item, str):
            out.append(item)
        elif isinstance(item, dict):
            out += [item["file"]] if "file" in item else []
            out += chapter_files(item.get("chapters"))
    return out


def add_to_book(yml: Path, chapter: str, part: str) -> bool:
    """List `chapter` in the book's chapters, at the end of the part `part`
    (made at the end of the chapters if missing, before a closing
    references.qmd). Edits the text, so comments and layout stay; False when
    the layout isn't one this understands."""
    lines = yml.read_text().splitlines(keepends=True)
    if lines and not lines[-1].endswith("\n"):
        lines[-1] += "\n"

    def indent(i):
        return len(lines[i]) - len(lines[i].lstrip(" "))

    def content(i):
        return lines[i].strip() != "" and not lines[i].lstrip().startswith("#")

    def item(i):
        return lines[i].lstrip().startswith("-")

    book = next((i for i, line in enumerate(lines) if re.match(r"book:\s*$", line)), None)
    if book is None:
        return False
    end = next((i for i in range(book + 1, len(lines)) if re.match(r"[^\s#]", lines[i])), len(lines))
    key = next((i for i in range(book + 1, end) if re.match(r"\s+chapters:\s*$", lines[i])), None)
    if key is None:
        return False
    last = key   # last line of the chapters list
    for i in range(key + 1, end):
        if not content(i):
            continue
        if indent(i) < indent(key) or (indent(i) == indent(key) and not item(i)):
            break
        last = i
    items = [i for i in range(key + 1, last + 1) if content(i) and item(i)]
    if not items:
        return False
    top = [i for i in items if indent(i) == indent(items[0])]
    # lists flush with their key (PyYAML's style) or indented under it
    step = 0 if indent(items[0]) == indent(key) else 2

    for n, i in enumerate(top):
        m = re.match(r"\s*-\s*part:\s*(.+?)\s*$", lines[i])
        if not (m and m.group(1).strip("'\"").lower() == part.lower()):
            continue
        block_end = top[n + 1] - 1 if n + 1 < len(top) else last
        sub = next((k for k in range(i + 1, block_end + 1) if re.match(r"\s+chapters:\s*$", lines[k])), None)
        if sub is None:
            return False
        at = max(k for k in range(sub, block_end + 1) if content(k))
        kids = [k for k in range(sub + 1, at + 1) if content(k) and item(k)]
        lines.insert(at + 1, " " * (indent(kids[0]) if kids else indent(sub) + step) + f"- {chapter}\n")
        break
    else:
        at = last + 1
        if re.match(r"\s*-\s*references\.qmd\s*$", lines[top[-1]]):
            at = top[-1]
        col = indent(top[0])
        lines[at:at] = [" " * col + f'- part: "{part}"\n', " " * (col + 2) + "chapters:\n",
                        " " * (col + 2 + step) + f"- {chapter}\n"]

    text = "".join(lines)
    try:
        import yaml
    except ImportError:
        pass
    else:
        try:
            if chapter not in chapter_files((yaml.safe_load(text) or {}).get("book", {}).get("chapters")):
                return False
        except yaml.YAMLError:
            return False
    yml.write_text(text)
    return True


def cmd_new(kind: str, dest: Path, title: str | None, columns: int = 1,
            part: str = "Assignments") -> None:
    if dest.exists() and any(dest.iterdir()):
        die(f"{dest} is not empty (use `newdoc link {dest}` for an existing project)")
    title = title or dest.name.replace("-", " ").replace("_", " ").capitalize()
    stem = slugify(dest.name)
    subs = {"TITLE": title, "SLUG": stem, "COLUMNS": "twocolumn" if columns == 2 else "onecolumn",
            **author_vars()}

    src = PROJECTS / kind
    for path in sorted(src.rglob("*")):
        rel = path.relative_to(src)
        if rel.name in ("main.qmd", "main.tex"):   # single documents take the folder's name
            rel = rel.with_name(stem + path.suffix)
        target = dest / rel
        if path.is_dir():
            target.mkdir(parents=True, exist_ok=True)
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        text = path.read_text()
        yaml = path.suffix in (".qmd", ".yml")   # values sit in "..." there
        for key, val in subs.items():
            text = text.replace("{{" + key + "}}", val.replace('"', '\\"') if yaml else val)
        target.write_text(text)

    shutil.copy(PROJECTS / f"{GITIGNORE[kind]}.gitignore", dest / ".gitignore")
    if kind != "tex":
        link_extensions(dest)
    main = next((p for p in (dest / f"{stem}.qmd", dest / f"{stem}.tex",
                             dest / "chapters/01-introduction.qmd") if p.exists()), dest)
    print(f"{kind} created: {main}")
    book = enclosing_book(dest) if kind == "report" else None
    if book:
        chapter = main.relative_to(book.parent).as_posix()
        if chapter in book.read_text():
            print(f"  already in {book}")
        elif add_to_book(book, chapter, part):
            print(f'  added to {book} (part "{part}"); it also renders alone from {dest.name}/')
        else:
            print(f"  inside the book {book.parent}: list it in the chapters of {book.name}:\n"
                  f"    - {chapter}")


def cmd_link(dest: Path) -> None:
    if not dest.is_dir():
        die(f"{dest} is not a folder")
    link_extensions(dest)


def main() -> None:
    p = argparse.ArgumentParser(prog="newdoc", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("kind", choices=[*KINDS, "link"])
    p.add_argument("dir", nargs="?", default=".")
    p.add_argument("-t", "--title")
    p.add_argument("-2", "--two-column", action="store_true",
                   help="report in two columns (wide figures: #| fig-env: figure*)")
    p.add_argument("--part", default="Assignments",
                   help="report inside a book: the part of the book it goes in (default: Assignments)")
    args = p.parse_args()
    dest = Path(args.dir).expanduser().resolve()
    if args.kind == "link":
        cmd_link(dest)
    else:
        cmd_new(args.kind, dest, args.title, 2 if args.two_column else 1, args.part)


if __name__ == "__main__":
    main()
